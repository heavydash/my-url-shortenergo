{
    "swagger": "2.0",
    "info": {
        "description": "Сервис сокращения URL с поддержкой различных хранилищ, аудита и graceful shutdown.",
        "title": "URL Shortener API",
        "termsOfService": "https://github.com/heavydash/my-url-shortenergo",
        "contact": {
            "name": "API Support",
            "url": "https://github.com/heavydash/my-url-shortenergo/issues",
            "email": "your-email@example.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/ping": {
            "get": {
                "description": "Возвращает статус \"ok\", если сервер запущен и готов принимать запросы",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Проверка работоспособности сервиса",
                "responses": {
                    "200": {
                        "description": "Успешный ответ",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "Cookie-based authorization",
            "type": "apiKey",
            "name": "token",
            "in": "cookie"
        }
    }
}