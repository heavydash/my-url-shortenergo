{
  "server_addr": ":9000",
  "base_url": "https://test-shortener.com",
  "file_storage_path": "/tmp/test-urls.json",
  "database_dsn": "postgres://user:pass@localhost:5432/shortener?sslmode=disable",
  "enable_https": true,
  "tls_cert": "custom.crt",
  "tls_key": "custom.key",
  "deletion_queue_buffer": 500,
  "deletion_flush_interval": "200ms",
  "deletion_max_batch_size": 200,
  "audit_file_path": "/var/log/shortener-audit.log",
  "audit_remote_url": "https://audit.example.com",
  "audit_buffer_size": 8192,
  "audit_shutdown_timeout": "30s",
  "db_max_conns": 50,
  "db_min_conns": 10,
  "db_max_conn_lifetime": "10m",
  "db_health_interval": "30s",
  "server_timeout": "20s",
  "init_timeout": "30s",
  "shutdown_timeout": "15s",
  "ping_timeout": "5s",
  "http_client_timeout": "10s"
}